5421888053467, "y": 57.769423558897245, "width": 82.18462823725982, "height": 7.142857142857139, "rotation": 0}, "id": "G6brbu7MDa", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 864, "original_height": 720, "image_rotation": 0, "value": {"x": 8.35421888053467, "y": 57.769423558897245, "width": 82.18462823725982, "height": 7.142857142857139, "rotation": 0, "labels": ["text"]}, "id": "G6brbu7MDa", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 864, "original_height": 720, "image_rotation": 0, "value": {"x": 8.35421888053467, "y": 57.769423558897245, "width": 82.18462823725982, "height": 7.142857142857139, "rotation": 0, "text": ["*The terms ventral and anterior are synonymous in humans, head in a cat but this is not the case in four-legged animals. Anterior refers to the leading portion of the body (abdominal surface in humans, head in a cat), but ventral specifically refers to the \"belly\" of a vertebrate animal, so it is the inferior surface of four-legged animals. Likewise, although the dorsal and posterior surfaces are the same in humans, the term dorsal specifically refers to an animal's back (as in the dorsal fin of a shark). Thus, the dorsal surface of four-legged animals is their superior surface."]}, "id": "G6brbu7MDa", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 864, "original_height": 720, "image_rotation": 0, "value": {"x": 5.012531328320802, "y": 79.4486215538847, "width": 45.217209690893895, "height": 3.383458646616546, "rotation": 0}, "id": "UgWrPQsFxK", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 864, "original_height": 720, "image_rotation": 0, "value": {"x": 5.012531328320802, "y": 79.4486215538847, "width": 45.217209690893895, "height": 3.383458646616546, "rotation": 0, "labels": ["text"]}, "id": "UgWrPQsFxK", "from_na