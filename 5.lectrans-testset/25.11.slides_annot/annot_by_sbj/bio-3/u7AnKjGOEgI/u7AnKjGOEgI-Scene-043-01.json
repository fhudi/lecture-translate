m toward the two poles of the cell.\n\nDuring telophase, nuclear envelopes re-form and chromosomes decondense. During cytokinesis in an animal cell, a band of filaments contracts around the equator of the cell, causing two cells to form from the original parent cell.\n\nThe two daughter cells enter G1 phase of interphase."]}, "id": "BB_2", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}], "created_username": "15. NAIST nlp_annot_15@naist.ac.jp, 21", "created_ago": "0\u00a0minutes", "completed_by": {"id": 21, "first_name": "15. NAIST", "last_name": "", "email": "nlp_annot_15@naist.ac.jp"}, "task": {"id": 141047, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec_slides/bio-3/u7AnKjGOEgI/u7AnKjGOEgI-Scene-043-01.jpg", "text": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/gpt_41mini_outs/bio-3/u7AnKjGOEgI/u7AnKjGOEgI-Scene-043-01.txt"}, "meta": {}, "created_at": "2025-11-01T12:33:29.006420Z", "updated_at": "2025-11-01T12:33:29.015903Z", "is_labeled": true, "overlap": 1, "inner_id": 33, "total_annotations": 1, "cancelled_annotations": 0, "total_predictions": 1, "comment_count": 0, "unresolved_comment_count": 0, "last_comment_updated_at": null, "project": 34, "updated_by": 1, "file_upload": null, "comment_authors": []}, "was_cancelled": false, "ground_truth": false, "created_at": "2025-11-02T10:54:04.432123Z", "updated_at": "2025-11-02T10:54:04.432148Z", "draft_created_at": null, "lead_time": 20.776, "import_id": null, "last_action": null, "bulk_created": false, "project": 34, "updated_by": 21, "parent_prediction": 141173, "parent_annotation": null, "last_created_by": null}