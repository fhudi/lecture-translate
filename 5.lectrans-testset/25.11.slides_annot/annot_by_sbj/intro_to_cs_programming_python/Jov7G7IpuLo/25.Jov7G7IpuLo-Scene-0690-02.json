l", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 18.5, "y": 22.4, "width": 30.3, "height": 40.5, "rotation": 0, "text": ["def getUSPop(fileName): inFile $=$ open(fileName, $\\because r ^ { \\prime }$ dates, pops $=$ [], [] for l in inFile: line $= \\cdot \\cdot$ for c in 1: if c in '0123456789 line += c line $=$ line.split(' ') dates.append(int(line[0])) pops.append(int(line[1])) return dates, pops "]}, "id": "BB_5", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 18.2, "y": 66.2, "width": 42.9, "height": 20.4, "rotation": 0}, "id": "BB_6", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 18.2, "y": 66.2, "width": 42.9, "height": 20.4, "rotation": 0, "labels": ["text"]}, "id": "BB_6", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 18.2, "y": 66.2, "width": 42.9, "height": 20.4, "rotation": 0, "text": ["dates, pops $=$ getUSPop('lec25_USPopulation.txt') plt.plot(dates, pops)   \nplt.title('Population in What Is Now U.S.\\n'+\\ (Native Am. Excluded Before 1860)') plt.xlabel('Year')   \nplt.ylabel('Population') "]}, "id": "BB_6", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}], "created_username": "18. NAIST nlp_annot_18@naist.ac.jp, 24", "created_ago": "0\u00a0minutes", "completed_by": {"id": 24, "first_name": "18. NAIST", "last_name": "", "email": "nlp_annot_18@naist.ac.jp"}, "task": {"id": 143476, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec