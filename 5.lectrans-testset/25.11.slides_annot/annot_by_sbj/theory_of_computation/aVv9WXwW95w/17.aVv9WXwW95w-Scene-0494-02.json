o_name": "image", "type": "textarea", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 22.57418397626113, "y": 0.8902077151335311, "width": 33.36331602373886, "height": 8.90207715133531, "rotation": 0}, "id": "xhakKcExAd", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 22.57418397626113, "y": 0.8902077151335311, "width": 33.36331602373886, "height": 8.90207715133531, "rotation": 0, "labels": ["text"]}, "id": "xhakKcExAd", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 22.57418397626113, "y": 0.8902077151335311, "width": 33.36331602373886, "height": 8.90207715133531, "rotation": 0, "text": ["PSPACE = NPSPACE"]}, "id": "xhakKcExAd", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 72.44621661721068, "y": 39.16913946587537, "width": 27.55378338278932, "height": 60.83086053412463, "rotation": 0}, "id": "QwyEvjk-yq", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 72.44621661721068, "y": 39.16913946587537, "width": 27.55378338278932, "height": 60.83086053412463, "rotation": 0, "labels": ["image"]}, "id": "QwyEvjk-yq", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}], "created_username": "12. Doshisha nlp_annot_12@naist.ac.jp, 18", "created_ago": "0\u00a0minutes", "completed_by": {"id": 18, "first_name": "12. Doshisha", "last_name": "", "email": "nlp_annot_12@naist.ac.jp"}, "task": {"id": 139566, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_too