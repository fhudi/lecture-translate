 DFA and u \u2192_b v by a ladder in L(B)}\n\nB-L = \"On input (B, u, v, b) Let m = |u| = |v|.\n1. For b = 1, accept if u, v \u2208 L(B) and differ in \u2264 1 place, else reject.\n2. For b > 1, repeat for each w \u2208 L(B) of length |u|."]}, "id": "5KnadjAw5X", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}], "created_username": "12. Doshisha nlp_annot_12@naist.ac.jp, 18", "created_ago": "0\u00a0minutes", "completed_by": {"id": 18, "first_name": "12. Doshisha", "last_name": "", "email": "nlp_annot_12@naist.ac.jp"}, "task": {"id": 139345, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec_slides/theory_of_computation/aVv9WXwW95w/17.aVv9WXwW95w-Scene-0152-03.jpg", "text": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/gpt_41mini_outs/theory_of_computation/aVv9WXwW95w/17.aVv9WXwW95w-Scene-0152-03.txt"}, "meta": {}, "created_at": "2025-11-01T12:32:51.278904Z", "updated_at": "2025-11-01T12:32:51.288356Z", "is_labeled": true, "overlap": 1, "inner_id": 208, "total_annotations": 1, "cancelled_annotations": 0, "total_predictions": 1, "comment_count": 0, "unresolved_comment_count": 0, "last_comment_updated_at": null, "project": 31, "updated_by": 1, "file_upload": null, "comment_authors": []}, "was_cancelled": false, "ground_truth": false, "created_at": "2025-11-20T02:30:23.302201Z", "updated_at": "2025-11-20T02:30:23.302231Z", "draft_created_at": "2025-11-20T02:12:54.669662Z", "lead_time": 962.428, "import_id": null, "last_action": null, "bulk_created": false, "project": 31, "updated_by": 18, "parent_prediction": null, "parent_annotation": null, "last_created_by": null}