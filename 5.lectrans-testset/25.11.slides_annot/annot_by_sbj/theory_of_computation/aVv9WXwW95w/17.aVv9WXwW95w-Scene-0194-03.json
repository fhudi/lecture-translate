"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 71.99999999999996, "y": 38.27893175074184, "width": 23.118360534124648, "height": 39.62106824925811, "rotation": 0}, "id": "BB_3", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 71.99999999999996, "y": 38.27893175074184, "width": 23.118360534124648, "height": 39.62106824925811, "rotation": 0, "labels": ["image"]}, "id": "BB_3", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 71.99999999999996, "y": 38.27893175074184, "width": 23.118360534124648, "height": 39.62106824925811, "rotation": 0, "text": [""]}, "id": "BB_3", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.8258531157270028, "y": 31.454005934718097, "width": 70.71031157270029, "height": 43.62017804154304, "rotation": 0}, "id": "1mAETCI1Zi", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.8258531157270028, "y": 31.454005934718097, "width": 70.71031157270029, "height": 43.62017804154304, "rotation": 0, "labels": ["equation"]}, "id": "1mAETCI1Zi", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.8258531157270028, "y": 31.454005934718097, "width": 70.71031157270029, "height": 43.62017804154304, "rotation": 0, "text": ["BOUNDED-LADDER_DFA = {(B, u, v, b) | B a DFA and u \u2192_b v by a ladder in L(B)}\n\nB-L = \"On input (B, u, v, b) Let m = |u| = |v|.\n1. For b = 1, accept if u, v \u2208 L(B) and differ in \u2264 1 place, else reject.\n2. For b > 1, repeat for each w \u2208 L(B) of length |u|\n3. Recursively test u \u2192_b/2 w and w \u2192_b/2 v [division rounds up]\n4. Accept both accept.\n5. Reject [if all fail].\"\n\nTest (B, u, v) \u2208 LADDER_DFA with B-L procedure on input (B, u, v, t) for t = |\u03a3|^m"]}, "id": "1mAETCI1Zi", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.4938798219584568, "y": 75.96439169139467, "width": 15.270771513353116, "height": 4.7477744807121525, "rotation": 0}, "id": "nENJdqC695", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.4938798219584568, "y": 75.96439169139467, "width": 15.270771513353116, "height": 4.7477744807121525, "rotation": 0, "labels": ["text"]}, "id": "nENJdqC695", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 1.4938798219584568, "y": 75.96439169139467, "width": 15.270771513353116, "height": 4.7477744807121525, "rotation": 0, "text": ["Space analysis:"]}, "id": "nENJdqC695", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"value": {"choices": ["No Error"]}, "id": "3H6ptoAQAR", "from_name": "severity", "to_name": "gpt-output", "type": "choices", "origin": "manual"}], "created_username": "12. Doshisha nlp_annot_12@naist.ac.jp, 18", "created_ago": "0\u00a0minutes", "completed_by": {"id": 18, "first_name": "12. Doshisha", "last_name": "", "email": "nlp_annot_12@naist.ac.jp"}, "task": {"id": 139387, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec_slides/theory_of_computation/aVv9WXwW95w/17.aVv9WXwW95w-Scene-019