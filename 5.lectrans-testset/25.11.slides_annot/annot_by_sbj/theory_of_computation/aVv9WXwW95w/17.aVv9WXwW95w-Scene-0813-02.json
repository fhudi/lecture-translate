iginal_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 2.1000000000000005, "y": 38.8000000000001, "width": 49.600000000000016, "height": 23.130463576158846, "rotation": 0, "labels": ["text"]}, "id": "BB_5", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 2.1000000000000005, "y": 38.8000000000001, "width": 49.600000000000016, "height": 23.130463576158846, "rotation": 0, "text": ["Theorem: TQBF is PSPACE-complete\n\nProof: 1) TQBF \u2208 PSPACE \u2713\n2) For all A \u2208 PSPACE, A \u2264\u209a TQBF\n\nLet A \u2208 PSPACE be decided by TM M in space n\u1d4f.\nGive a polynomial-time reduction f mapping A to TQBF."]}, "id": "BB_5", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction-changed"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 2.5, "y": 77.9, "width": 58.7, "height": 5.3, "rotation": 0}, "id": "BB_6", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 2.5, "y": 77.9, "width": 58.7, "height": 5.3, "rotation": 0, "labels": ["text"]}, "id": "BB_6", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 2.5, "y": 77.9, "width": 58.7, "height": 5.3, "rotation": 0, "text": ["Plan: Design \u03c6M,w to \"say\" M accepts w. \u03c6M,w simulates M on w."]}, "id": "BB_6", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 640, "original_height": 358, "image_rotation": 0, "value": {"x": 4.568846578366451, "y": 62.251655629139044, "width": 22.47378587196469, "height": 14.56953642384107, "rotation": 0}, "id": "MA35D1VOrH", "from_name": "bbox", "to_name":