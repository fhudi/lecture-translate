, "original_height": 1080, "image_rotation": 0, "value": {"x": 11.758474576271185, "y": 26.55367231638418, "width": 78.17796610169492, "height": 72.31638418079096, "rotation": 0}, "id": "1ZuRbKJuZr", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 11.758474576271185, "y": 26.55367231638418, "width": 78.17796610169492, "height": 72.31638418079096, "rotation": 0, "labels": ["text"]}, "id": "1ZuRbKJuZr", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 11.758474576271185, "y": 26.55367231638418, "width": 78.17796610169492, "height": 72.31638418079096, "rotation": 0, "text": ["\u2022 What did Frisch mean by turning economics into a science?\n\u2022 Matzkin classified the variable of economic models into various binary categories. Please list one group and explain what is meant.\n\u2022 Angrist distinguishes randomized trials from quasi experiments (or natural experiments). Please explain what he means by this distinction and give one example from each of the two groups.\n\u2022 Varian speaks of big data as consisting of machine learning and data sci- ence. What do these techniques accomplish? What do they fail to accom- plish and why?\n\u2022 Lucas refers to economic models as laboratories. What did he mean by this? What is the advantage of using a model versus thinking about what is going on in an actual economy?\n\u2022 Discuss the way village economies can differ from one another in terms of credit and insurance (presence or absence) for example. Or in terms of means of \"payment\" (shells, cash) as another example. Pick one example, either credit/insurance or means of payment and describe the contrasts.\n\u2022 What does it mean to say village economics are a metaphor for the study of modern financial systems? Give one example of what we mean by this.)\n\u2022 List the key ingredients we need in order to specify what we mean by an economy in general equilibrium terms. Make sure your answer is complete."]}, "id": "1ZuRbKJuZr", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}], "created_username": "06. Doshisha nlp_annot_06@naist.ac.jp, 12", "created_ago": "0\u00a0minutes", "completed_by": {"id": 12, "first_name": "06. Doshisha", "last_name": "", "email": "nlp_annot_06@naist.ac.jp"}, "task": {"id": 135652, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec_slides/intmd_microeconomics/rhOpABGewYA/02.rhOpABGewYA-Scene-011-03.jpg", "text": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/gpt_41mini_outs/intmd_microeconomics/rhOpABGewYA/02.rhOpABGewYA-Scene-011-03.txt"}, "meta": {}, "created_at": "2025-11-01T12:31:29.194751Z", "updated_at": "2025-11-01T12:31:29.208105Z", "is_labeled": true, "overlap": 1, "inner_id": 41, "total_annotations": 1, "cancelled_annotations": 0, "total_predictions": 1, "comment_count": 0, "unresolved_comment_count": 0, "last_comment_updated_at": null, "project": 25, "updated_by": 1, "file_upload": null, "comment_authors": []}, "was_cancelled": false, "ground_truth": false, "created_at": "2025-11-27T18:24:23.813521Z", "updated_at": "2025-11-27T18:24:23.813547Z", "draft_created_at": "2025-11-27T18:23:36.201349Z", "lead_time": 66.08, "import_id": null, "last_action": null, "bulk_created": false, "project": 25, "updated_by": 12, "parent_prediction": 135778, "parent_annotation": null, "last_created_by": null}