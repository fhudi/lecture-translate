tion": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.7, "height": 14.2, "rotation": 0}, "id": "BB_3", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.7, "height": 14.2, "rotation": 0, "labels": ["text"]}, "id": "BB_3", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.7, "height": 14.2, "rotation": 0, "text": ["Let (x*, y*, p, w) be a price equilibrium with transfers. Then, if preferences are rational and locally non-satiated, then (x*, y*) is a Pareto Optimal allocation."]}, "id": "BB_3", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 50.5, "width": 71.2, "height": 19.7, "rotation": 0}, "id": "BB_4", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 50.5, "width": 71.2, "height": 19.7, "rotation": 0, "labels": ["text"]}, "id": "BB_4", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 50.5, "width": 71.2, "height": 19.7, "rotation": 0, "text": ["Note that for this theorem, we need not assume anything about the consumption set Xi for each agent, other that it has to be consistent with the requirement of local non satiation (i.e. for any given bundle there must exist an arbitrarily close bundle that is strictly preferred)."]}, "id": "BB_4", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "origin