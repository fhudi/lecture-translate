"x": 14.5, "y": 23.8, "width": 63.3, "height": 4.2, "rotation": 0}, "id": "BB_3", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.5, "y": 23.8, "width": 63.3, "height": 4.2, "rotation": 0, "labels": ["text"]}, "id": "BB_3", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.5, "y": 23.8, "width": 63.3, "height": 4.2, "rotation": 0, "text": ["\"The basic message that has emerged from the literature is negative:"]}, "id": "BB_3", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.3, "height": 26.4, "rotation": 0}, "id": "BB_4", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.3, "height": 26.4, "rotation": 0, "labels": ["text"]}, "id": "BB_4", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 27.7, "width": 70.3, "height": 26.4, "rotation": 0, "text": ["computing a Walrasian equilibrium tends to be \"hard\" in general settings. For\nexample, Chen et al. (2009a) prove that finding a Walrasian equilibrium is\nhard (PPAD-complete and hard to approximate) even in economies with\npiece-wise linear concave utilities that are separable by goods. Similarly,\nCodenotti et al. (2006) prove that the problem is also hard in economies in\nwhich agents have Leontief preferences."]}, "id": "BB_4", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 54.4, "width": 71, "height": 26.4, "rotation": 0}, "id": "BB_5", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 54.4, "width": 71, "height": 26.4, "rotation": 0, "labels": ["text"]}, "id": "BB_5", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 54.4, "width": 71, "height": 26.4, "rotation": 0, "text": ["In contrast, for more limited settings, there exist positive results ... there is a\ngap between the generality of the hardness results and the specificity of the\ninstances for which finding an equilibrium is tractable. The goal of the current\nwork is to find a middle ground where computing a Walrasian equilibrium is\ntractable, but which can still capture settings that include economic\napplications of the theory."]}, "id": "BB_5", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 81.1, "width": 65.5, "height": 8.6, "rotation": 0}, "id": "BB_6", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 81.1, "width": 65.5, "height": 8.6, "rotation": 0, "labels": ["text"]}, "id": "BB_6", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 81.1, "width": 65.5, "height": 8.6, "rotation": 0, "text": ["Our approach is different, it uses a combinatorial version of the Negishi\napproach for proving existence of Walrasian equilibria (Negishi 1960).\""]}, "id": "BB_6", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}], "created_username": "10. NAIST nlp_annot_10@naist.ac.jp, 16", "created_ago": "0\u00a0minutes", "completed_by": {"id": 16, "first_name": "10. NAIST", "last_name": "", "email": "nlp_annot_10@naist.ac.jp"}, "task": {"id": 138002, "data": {"ocr": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/lec_slides/intmd_microeconomics/Dqko567cE9I/24.Dqko567cE9I-Scene-118-01.jpg", "text": "/lectrans/data/local-files/?d=/large/datas/frederikus-h/lectrans-testset/25.10.annot_tools/label-studio/ocr_check_storage_source/gpt_41mini_outs/intmd_microeconomics/Dqko567cE9I/24.Dqko567cE9I-Scene-118-01.txt"}, "meta": {}, "created_at": "2025-11-01T12:32:21.876689Z", "updated_at": "2025-11-01T12:32:21.886225Z", "is_labeled": true, "overlap": 1, "inner_id": 115, "total_annotations": 1, "cancelled_annotations": 0, "total_predictions": 1, "comment_count": 0, "unresolved_comment_count": 0, "last_comment_updated_at": null, "project": 29, "updated_by": 1, "file_upload": null, "comment_authors": []}, "was_cancelled": false, "ground_truth": false, "created_at": "2025-11-13T14:48:05.988736Z", "updated_at": "2025-11-13T14:48:05.988762Z", "draft_created_at": "2025-11-13T14:47:49.061761Z", "lead_time": 32.835, "import_id": null, "last_action": null, "bulk_created": false, "project": 29, "updated_by": 16, "parent_prediction": 138128, "parent_annotation": null, "last_created_by": null}