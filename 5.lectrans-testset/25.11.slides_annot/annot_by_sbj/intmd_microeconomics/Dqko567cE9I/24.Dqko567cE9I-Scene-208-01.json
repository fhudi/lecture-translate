{"id": 7180, "result": [{"value": {"choices": []}, "id": "wftCRbQmwf", "from_name": "flags", "to_name": "image", "type": "choices", "origin": "prediction"}, {"value": {"choices": ["No Error"]}, "id": "K40IPSQoOR", "from_name": "severity", "to_name": "gpt-output", "type": "choices", "origin": "prediction-changed"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 13.9, "y": 6.9, "width": 68.9, "height": 12.5, "rotation": 0}, "id": "BB_1", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 13.9, "y": 6.9, "width": 68.9, "height": 12.5, "rotation": 0, "labels": ["text"]}, "id": "BB_1", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 13.9, "y": 6.9, "width": 68.9, "height": 12.5, "rotation": 0, "text": ["\"A Revealed Preference Approach to Computational Complexity in Economics\", Echenique et al (2013)"]}, "id": "BB_1", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 22.7, "width": 71.4, "height": 32.3, "rotation": 0}, "id": "BB_2", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 22.7, "width": 71.4, "height": 32.3, "rotation": 0, "labels": ["text"]}, "id": "BB_2", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.3, "y": 22.7, "width": 71.4, "height": 32.3, "rotation": 0, "text": ["Consumption theory assumes that consumers posses infinite computational abilities. Proponents of bounded rationality want to instead require that any model of consumer behavior incorporate computational constraints. In this paper, we establish that this requirement has no testable implications. Any consumption data set that is compatible with a rational consumer is also compatible with a rational and computationally bounded consumer (such a data set is rationalizable by a utility function that is easy to maximize over any budget set; specifically with a utility that can be maximized in strongly polynomial time)."]}, "id": "BB_2", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 55.8, "width": 70.1, "height": 38.9, "rotation": 0}, "id": "BB_3", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 55.8, "width": 70.1, "height": 38.9, "rotation": 0, "labels": ["text"]}, "id": "BB_3", "from_name": "label", "to_name": "image", "type": "labels", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 14.2, "y": 55.8, "width": 70.1, "height": 38.9, "rotation": 0, "text": ["The result is extended to data on multiple agents interacting in a market economy. We present sufficient conditions on observed market outcomes such that they are compatible with an instance of the model for which Walrasian equilibrium is easy to compute. Our result motivates a general approach for posing questions about the empirical content of computational constraints: the revealed preference approach to computational complexity. The approach complements the conventional worst-case view of computational complexity in important ways, and is methodologically close to mainstream economics."]}, "id": "BB_3", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "prediction"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 17.115542763157894, "y": 96.71052631578947, "width": 15.451511583830179, "height": 3.2894736842105345, "rotation": 0}, "id": "LGsYaOy5h2", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 17.115542763157894, "y": 96.71052631578947, "width": 15.451511583830179, "height": 3.2894736842105345, "rotation": 0, "labels": ["text"]}, "id": "LGsYaOy5h2", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 17.115542763157894, "y": 96.71052631578947, "width": 15.451511583830179, "height": 3.2894736842105345, "rotation": 0, "text": ["Robert M. Townsend (MIT)"]}, "id": "LGsYaOy5h2", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 32.1032072368421, "y": 0.6578947368421052, "width": 16.83799342105263, "height": 2.796052631578948, "rotation": 0}, "id": "p-g4-jKG9P", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 32.1032072368421, "y": 0.6578947368421052, "width": 16.83799342105263, "height": 2.796052631578948, "rotation": 0, "labels": ["text"]}, "id": "p-g4-jKG9P", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 1920, "original_height": 1080, "image_rotation": 0, "value": {"x": 32.1032072368421, "y": 0.6578947368421052, "width": 16.83799342105263, "height": 2.796052631578948, "rotation": 0, "text": ["Computational Considerations"]}, "id": "p-g4-jKG9P", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}], "created_username": "1