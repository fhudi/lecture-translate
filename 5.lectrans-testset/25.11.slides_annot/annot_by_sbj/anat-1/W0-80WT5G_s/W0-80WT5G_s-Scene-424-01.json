8080697928, "height": 3.1019023385435602, "rotation": 0, "text": ["Functional Class: Neuron Type According to Direction of Impulse Conduction"]}, "id": "0orIi9IgIe", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.580152671755725, "y": 30.825154489276628, "width": 35.55070883315158, "height": 12.019871561856299, "rotation": 0}, "id": "f9SXEJ6ufD", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.580152671755725, "y": 30.825154489276628, "width": 35.55070883315158, "height": 12.019871561856299, "rotation": 0, "labels": ["text"]}, "id": "f9SXEJ6ufD", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.580152671755725, "y": 30.825154489276628, "width": 35.55070883315158, "height": 12.019871561856299, "rotation": 0, "text": ["1. Most multipolar neurons are interneurons that conduct impulses within the CNS, integrating sensory input or motor output. May be one of a chain of CNS neurons, or a single neuron connecting sensory and motor neurons."]}, "id": "f9SXEJ6ufD", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.689203925845147, "y": 43.426632739609836, "width": 35.44165757906216, "height": 7.948624742517879, "rotation": 0}, "id": "c_UMjH-0Gs", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.689203925845147, "y": 43.426632739609836, "width": 35.44165757906216, "height": 7.948624742517879, "rotation": 0, "labels": ["text"]}, "id": "c_UMjH-0Gs", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 4.689203925845147, "y": 43.426632739609836, "width": 35.44165757906216, "height": 7.948624742517879, "rotation": 0, "text": ["2. Some multipolar neurons are motor neurons that conduct impulses along the efferent pathways from the CNS to an effector (muscle/gland)."]}, "id": "c_UMjH-0Gs", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 41.43947655398037, "y": 30.825154489276628, "width": 25.954198473282446, "height": 16.47885617351266, "rotation": 0}, "id": "20NyhLLpKL", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 41.43947655398037, "y": 30.825154489276628, "width": 25.954198473282446, "height": 16.47885617351266, "rotation": 0, "labels": ["text"]}, "id": "20NyhLLpKL", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 41.43947655398037, "y": 30.825154489276628, "width": 25.954198473282446, "height": 16.47885617351266, "rotation": 0, "text": ["Essentially all bipolar neurons are sensory neurons that are located in some special sense organs. For example, bipolar cells of the retina are involved with transmitting visual inputs from the eye to the brain (via an intermediate chain of neurons)."]}, "id": "20NyhLLpKL", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 69.57470010905126, "y": 30.631285593117653, "width": 25.190839694656475, "height": 14.540167211922935, "rotation": 0}, "id": "tNOCZlK4k8", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 69.57470010905126, "y": 30.631285593117653, "width": 25.190839694656475, "height": 14.540167211922935, "rotation": 0, "labels": ["text"]}, "id": "tNOCZlK4k8", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 69.57470010905126, "y": 30.631285593117653, "width": 25.190839694656475, "height": 14.540167211922935, "rotation": 0, "text": ["Most unipolar neurons are sensory neurons that conduct impulses along afferent pathways to the CNS for interpretation. (These sensory neurons are called primary or first-order sensory neurons.)"]}, "id": "tNOCZlK4k8", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 11.777535441657578, "y": 54.671028716830236, "width": 21.81025081788441, "height": 27.335514358415125, "rotation": 0}, "id": "ZnpuU7mxLs", "from_name": "bbox", "to_name": "image", "type": "rectangle", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 11.777535441657578, "y": 54.671028716830236, "width": 21.81025081788441, "height": 27.335514358415125, "rotation": 0, "labels": ["image"]}, "id": "ZnpuU7mxLs", "from_name": "label", "to_name": "image", "type": "labels", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 11.777535441657578, "y": 54.671028716830236, "width": 21.81025081788441, "height": 27.335514358415125, "rotation": 0, "text": ["Interneuron\nMotor neuron\nImpulse\nMuscle"]}, "id": "ZnpuU7mxLs", "from_name": "transcription", "to_name": "image", "type": "textarea", "origin": "manual"}, {"original_width": 2560, "original_height": 1440, "image_rotation": 0, "value": {"x": 40.676